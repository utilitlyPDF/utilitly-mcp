{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    // The server runs in Node.js; the MCP SDK's types also reference Node's.
    "types": ["node"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "strict": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "test", "*.config.ts"]
}
